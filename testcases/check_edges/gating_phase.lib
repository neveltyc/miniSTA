library (check_edges) {
  delay_model : table_lookup;
  time_unit : "1ns";
  capacitive_load_unit (1,pf);
  nom_voltage : 1; nom_temperature : 25; nom_process : 1;
  slew_lower_threshold_pct_rise : 20; slew_upper_threshold_pct_rise : 80;
  slew_lower_threshold_pct_fall : 20; slew_upper_threshold_pct_fall : 80;
  input_threshold_pct_rise : 50; input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50; output_threshold_pct_fall : 50;
  lu_table_template (check) {
    variable_1 : related_pin_transition; variable_2 : constrained_pin_transition;
    index_1 ("0.1, 0.5"); index_2 ("0.1, 0.5");
  }
  cell (BUF) {
    area : 1;
    pin (A) { direction : input; capacitance : 0.001; }
    pin (Y) { direction : output; function : "A";
      timing () { related_pin : "A"; timing_sense : positive_unate;
        cell_rise (scalar) { values ("2"); }
        cell_fall (scalar) { values ("1"); }
        rise_transition (scalar) { values ("0.2"); }
        fall_transition (scalar) { values ("0.4"); }
      }
    }
  }
  cell (OR2) {
    area : 1;
    pin (A) { direction : input; capacitance : 0.001; }
    pin (B) { direction : input; capacitance : 0.001; }
    pin (Y) { direction : output; function : "A | B";
      timing () { related_pin : "A"; timing_sense : positive_unate;
        cell_rise (scalar) { values ("10"); }
        cell_fall (scalar) { values ("1"); }
        rise_transition (scalar) { values ("0.2"); }
        fall_transition (scalar) { values ("0.4"); }
      }
      timing () { related_pin : "B"; timing_sense : positive_unate;
        cell_rise (scalar) { values ("0"); }
        cell_fall (scalar) { values ("2"); }
        rise_transition (scalar) { values ("0.2"); }
        fall_transition (scalar) { values ("0.4"); }
      }
    }
  }
  cell (DFF) {
    area : 1;
    ff (IQ, IQN) { clocked_on : "CLK"; next_state : "D"; clear : "!RN"; }
    pin (CLK) { direction : input; clock : true; capacitance : 0.001; }
    pin (D) { direction : input; capacitance : 0.001;
      timing () { related_pin : "CLK"; timing_type : setup_rising;
        rise_constraint (check) { values ("0.3, 1.1", "0.7, 1.5"); }
        fall_constraint (check) { values ("3.3, 4.1", "3.7, 4.5"); }
      }
      timing () { related_pin : "CLK"; timing_type : hold_rising;
        rise_constraint (check) { values ("2.3, 3.1", "2.7, 3.5"); }
        fall_constraint (check) { values ("0.3, 1.1", "0.7, 1.5"); }
      }
    }
    pin (RN) { direction : input; capacitance : 0.001;
      timing () { related_pin : "CLK"; timing_type : recovery_falling;
        rise_constraint (scalar) { values ("-10"); }
        fall_constraint (scalar) { values ("0"); }
      }
      timing () { related_pin : "CLK"; timing_type : removal_falling;
        rise_constraint (scalar) { values ("2"); }
        fall_constraint (scalar) { values ("-10"); }
      }
    }
    pin (Q) { direction : output; function : "IQ";
      timing () { related_pin : "CLK"; timing_type : rising_edge; timing_sense : non_unate;
        cell_rise (scalar) { values ("0.1"); }
        cell_fall (scalar) { values ("0.1"); }
        rise_transition (scalar) { values ("0.1"); }
        fall_transition (scalar) { values ("0.1"); }
      }
    }
  }
  cell (ICG) {
    area : 1;
    clock_gating_integrated_cell : latch_negedge;
    pin (CLK) { direction : input; clock : true; clock_gate_clock_pin : true; capacitance : 0.001; }
    pin (GATE) { direction : input; clock_gate_enable_pin : true; capacitance : 0.001;
      timing () { related_pin : "CLK"; timing_type : setup_falling;
        rise_constraint (scalar) { values ("-10"); }
        fall_constraint (scalar) { values ("0"); }
      }
      timing () { related_pin : "CLK"; timing_type : hold_falling;
        rise_constraint (scalar) { values ("2"); }
        fall_constraint (scalar) { values ("-10"); }
      }
    }
    pin (GCLK) { direction : output; function : "CLK & GATE"; clock_gate_out_pin : true;
      timing () { related_pin : "CLK"; timing_sense : positive_unate;
        cell_rise (scalar) { values ("0.1"); }
        cell_fall (scalar) { values ("0.1"); }
        rise_transition (scalar) { values ("0.1"); }
        fall_transition (scalar) { values ("0.1"); }
      }
    }
  }
}
